# ============================================================================
# NEXUS SOCIAL AUTOMATION v2.0 - ENVIRONMENT CONFIGURATION (Termux + APK)
# ============================================================================
NEXUS_HOST=127.0.0.1
NEXUS_PORT=5050
NEXUS_TIMEZONE=Asia/Gaza
DEFAULT_OPERATION_MODE=SMART_HYBRID
# Modes: FULL_AUTO | SMART_HYBRID | APPROVAL_QUEUE

# --- 9 FREE AI PROVIDERS (Auto-Failover & Smart Load Balancing) ---
# 1. Google Gemini API (Free Tier - Primary Multimodal & Arabic)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 2. Groq Cloud (Free Tier - Ultra-fast LPU & Whisper Audio Transcription)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# 3. Cerebras Inference (Free Tier - 2000+ tok/s)
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b

# 4. GitHub Models (Free with your GitHub Personal Access Token)
GITHUB_MODELS_TOKEN=
GITHUB_MODELS_MODEL=gpt-4o-mini

# 5. OpenRouter (Free Models Tier :free suffix)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-r1:free

# 6. Cohere API (Free Trial Key - Strong Arabic & Summarization)
COHERE_API_KEY=
COHERE_MODEL=command-a-03-2025

# 7. Mistral AI (Free La Plateforme Tier)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# 8. Cloudflare Workers AI (Free 10,000 Neurons/day + Flux Free Image Gen)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_TEXT_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# 9. Oxion AI + Pollinations.ai (Zero-Key Free Fallback - Works with NO API KEY!)
OXION_API_KEY=
OXION_BASE_URL=https://api.oxion.ai/v1
OXION_MODEL=gpt-5.6-luna
ENABLE_POLLINATIONS_FALLBACK=true

# --- MEDIA FACTORY & GITHUB HTTPS RELAY ---
PEXELS_API_KEY=
GITHUB_RELAY_TOKEN=
GITHUB_RELAY_REPO=Dev-saged/media-relay-vault
GITHUB_RELAY_BRANCH=main
AVOID_WOMEN_FILTER=true
UNIQUIFY_LOGO_PATH=
